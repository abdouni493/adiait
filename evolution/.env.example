# =============================================================================
#  LES CINQ SECRETS DU POSTE QUI HÉBERGE LA PASSERELLE
# =============================================================================
#
#  Copiez ce fichier en `.env` — qui n'est PAS versionné — et remplissez-le.
#  Ces valeurs ne vont JAMAIS chez l'hébergeur de l'application : elles ne
#  concernent que la machine qui fait tourner les conteneurs.
#
#  ⚠️ LORS D'UN DÉMÉNAGEMENT DU POSTE, `.env` DOIT ÊTRE TRANSPORTÉ À LA MAIN.
#  Il n'est pas dans le dépôt, et rien ne vous le rappellera au moment où vous
#  en aurez besoin.
# =============================================================================


# -----------------------------------------------------------------------------
#  SE RÉUTILISE d'un projet à l'autre
# -----------------------------------------------------------------------------

# La clé d'authentification Tailscale.
#   Settings -> Keys -> Generate auth key
#   • cochez REUSABLE (c'est ce qui permet de la réutiliser) ;
#   • NE COCHEZ JAMAIS « Ephemeral » : un nœud éphémère disparaît à l'arrêt, et
#     l'adresse publique avec lui.
# Un seul compte Tailscale suffit pour tous les projets d'une même structure.
TAILSCALE_AUTHKEY=tskey-auth-xxxxxxxxxxxx


# -----------------------------------------------------------------------------
#  DOIT ÊTRE NEUF pour chaque projet — et deux de ces valeurs cassent EN SILENCE
# -----------------------------------------------------------------------------

# Le nom du nœud. Il n'est à récupérer nulle part : C'EST UN NOM QUE L'ON
# CHOISIT. Il décide de la première moitié de l'adresse publique.
#
# ⚠️ Tailscale n'attribue jamais deux fois le même nom : si un nœud le porte
# déjà, le nouveau devient `<nom>-1` et L'ADRESSE PUBLIQUE CHANGE — ce qui
# RESSEMBLE À UNE RÉUSSITE. Pour déménager, supprimez d'abord l'ancien nœud
# dans Machines.
TAILSCALE_HOSTNAME=adiyet-wa

# L'adresse publique de la passerelle : https:// + le nom ci-dessus + . + le nom
# de votre tailnet (DNS -> Tailnet name), SANS SLASH FINAL.
#
# ⚠️ ELLE DOIT VALOIR EXACTEMENT `EVOLUTION_BASE_URL` côté application. Elle est
# estampillée dans chaque webhook, que l'application compare au caractère près :
# un slash en trop d'un seul côté ⇒ TOUS les accusés de remise refusés en 403,
# sans la moindre erreur nulle part.
TUNNEL_PUBLIC_URL=https://adiyet-wa.votre-tailnet.ts.net

# La clé d'API de la passerelle. Inventez-la (32 caractères aléatoires).
# ⚠️ Elle doit valoir EXACTEMENT `EVOLUTION_API_KEY` côté application.
EVOLUTION_API_KEY=changez-moi-32-caracteres-aleatoires

# Le mot de passe Postgres de la passerelle.
# ⚠️ IL NE PEUT PLUS CHANGER une fois le volume initialisé : il n'est appliqué
# qu'à la création de la base. Le modifier ensuite fait rejeter la connexion, et
# la passerelle ne démarre plus. Pour en changer réellement, il faut supprimer
# le volume — donc la base de la passerelle.
POSTGRES_PASSWORD=changez-moi-aussi
