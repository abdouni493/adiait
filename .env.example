# =============================================================================
#  LES VARIABLES D'ENVIRONNEMENT DE L'APPLICATION
# =============================================================================
#
#  Copiez ce fichier en `.env.local` (qui n'est pas versionné) et remplissez-le.
#
#  ⚠️ CHEZ L'HÉBERGEUR, ELLES NE SONT LUES QU'AU DÉPLOIEMENT. Les poser sans
#  REDÉPLOYER ne change rien — et c'est le genre de détail qui fait chercher
#  pendant une heure une panne qui n'existe pas.
# =============================================================================


# -----------------------------------------------------------------------------
#  1. LE PROJET SUPABASE VISÉ PAR L'APPLICATION  (facultatif)
# -----------------------------------------------------------------------------
#  Sans ces deux variables, l'application se connecte au projet du club, écrit
#  en dur dans `lib/supabase/client.ts`, pour qu'un dépôt fraîchement cloné
#  démarre sans configuration. Posez-les pour viser un autre projet — une
#  préproduction, un autre club.
#
#  LA CLÉ « ANON » EST PUBLIQUE : elle finit dans le navigateur de tout le monde
#  et ne donne aucun droit par elle-même — c'est la RLS qui décide.

NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon


# -----------------------------------------------------------------------------
#  2. LA PASSERELLE WHATSAPP  (obligatoire pour envoyer des messages)
# -----------------------------------------------------------------------------
#
#  AUCUNE DE CES VARIABLES NE PORTE LE PRÉFIXE `NEXT_PUBLIC_`, ET C'EST TOUT LE
#  SUJET. Ce préfixe ferait entrer la clé de la passerelle dans le paquet
#  JavaScript téléchargé par chaque visiteur : le numéro WhatsApp du club offert
#  à qui sait ouvrir l'onglet réseau. Elles sont lues UNIQUEMENT par les routes
#  de `app/api/whatsapp/`.
#
#  Le montage du poste qui héberge la passerelle est décrit dans
#  `evolution/README.md`.

# L'adresse publique de la passerelle, SANS SLASH FINAL.
#  ⚠️ Elle doit valoir EXACTEMENT le `TUNNEL_PUBLIC_URL` du conteneur : cette
#  valeur est estampillée dans le champ `server_url` de chaque accusé de remise,
#  que l'application compare AU CARACTÈRE PRÈS. Un slash en trop d'un seul côté
#  ⇒ tous les accusés refusés en 403, et rien nulle part ne le signale.
EVOLUTION_BASE_URL=https://adiyet-wa.votre-tailnet.ts.net

# La clé d'API de la passerelle.
#  ⚠️ Elle doit valoir EXACTEMENT `AUTHENTICATION_API_KEY` du conteneur.
EVOLUTION_API_KEY=la-meme-que-dans-evolution/.env

# Le nom de l'instance côté passerelle. Par défaut : « station ».
EVOLUTION_INSTANCE=adiyet

# Le `Bearer` que la passerelle présentera à chaque accusé de remise.
#  Inventez-le (32 caractères aléatoires). C'est lui, ET le champ `server_url`
#  du corps, qui protègent l'endpoint : deux contrôles, pas un. Sans jeton, la
#  route répond 401 — c'est exactement ce que le script de diagnostic éprouve.
EVOLUTION_WEBHOOK_TOKEN=inventez-32-caracteres-aleatoires

# ⚠️ NE DÉFINISSEZ PAS `EVOLUTION_WEBHOOK_URL`.
#  L'adresse du webhook se DÉDUIT du domaine sur lequel l'application répond, et
#  ce pour deux raisons vécues chacune deux fois :
#   • le webhook est stocké SUR LA PASSERELLE, pas dans l'application : il
#     survit à un déménagement et continue de pointer vers l'ancienne adresse —
#     les messages partent, aucun accusé ne revient, aucune erreur nulle part ;
#   • recopier un `.env` local en bloc vers l'hébergeur emporte
#     `http://host.docker.internal:3000`.
#  Si la variable est posée malgré tout, elle est ÉCARTÉE et NOMMÉE dans le
#  diagnostic de l'écran Réglages → WhatsApp.


# -----------------------------------------------------------------------------
#  3. LE JOURNAL ET LA FILE D'ATTENTE WHATSAPP  (fortement recommandé)
# -----------------------------------------------------------------------------
#
#  LA CLÉ DE SERVICE NE DOIT JAMAIS REJOINDRE UN NAVIGATEUR. Elle n'est lue que
#  par les routes serveur, et sert à deux choses que la RLS ne permet pas :
#   • écrire le JOURNAL des messages (le webhook vient de la passerelle, il n'a
#     aucune session utilisateur) ;
#   • tenir la FILE D'ATTENTE.
#
#  SANS ELLE, l'envoi direct fonctionne toujours — mais tout message émis
#  passerelle éteinte est PUREMENT PERDU, et aucun accusé de remise n'est
#  enregistré. L'écran Réglages → WhatsApp le DIT au lieu de le taire.
#
#  Supabase Dashboard -> Project Settings -> API -> `service_role`.

SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role
