# LE PROJET SUPABASE VISÉ PAR L'APPLICATION.
#
# Ces deux variables sont FACULTATIVES : sans elles, l'application se connecte
# au projet de l'école, écrit en dur dans `lib/supabase/client.ts`, pour qu'un
# dépôt fraîchement cloné démarre sans configuration. Posez-les pour viser un
# autre projet — une préproduction, une autre école.
#
# Copiez ce fichier en `.env.local` (qui n'est pas versionné) et remplissez-le.
#
# LA CLÉ « ANON » EST PUBLIQUE : elle finit dans le navigateur de tout le monde
# et ne donne aucun droit par elle-même — c'est la RLS qui décide. La clé de
# service (`service_role`), elle, ne doit JAMAIS figurer ici ni ailleurs dans ce
# dépôt : l'application n'en a pas besoin.

NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon
